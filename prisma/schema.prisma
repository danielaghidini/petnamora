generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  dogs Dog[]
  sessions Session[]
  messages Message[]
  reports Report[]
}
model Session {
  id String @id @default(cuid())
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Dog {
  id String @id @default(cuid())
  ownerId String
  name String
  breed String
  sex String
  ageMonths Int
  size String
  city String
  state String
  bio String
  photoUrl String
  pedigree Boolean @default(false)
  vaccinated Boolean @default(false)
  healthTests Boolean @default(false)
  neutered Boolean @default(false)
  active Boolean @default(true)
  demo Boolean @default(false)
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sentLikes Like[] @relation("LikesFrom")
  receivedLikes Like[] @relation("LikesTo")
  matchesA Match[] @relation("MatchA")
  matchesB Match[] @relation("MatchB")
  reports Report[]
  @@index([active, demo, breed, sex, state])
  @@index([ownerId])
}
model Like {
  id String @id @default(cuid())
  fromId String
  toId String
  createdAt DateTime @default(now())
  from Dog @relation("LikesFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to Dog @relation("LikesTo", fields: [toId], references: [id], onDelete: Cascade)
  @@unique([fromId, toId])
}
model Match {
  id String @id @default(cuid())
  dogAId String
  dogBId String
  createdAt DateTime @default(now())
  dogA Dog @relation("MatchA", fields: [dogAId], references: [id], onDelete: Cascade)
  dogB Dog @relation("MatchB", fields: [dogBId], references: [id], onDelete: Cascade)
  messages Message[]
  @@unique([dogAId, dogBId])
}
model Message {
  id String @id @default(cuid())
  matchId String
  senderId String
  text String
  createdAt DateTime @default(now())
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([matchId, createdAt])
}
model Report {
  id String @id @default(cuid())
  reporterId String
  dogId String
  reason String
  createdAt DateTime @default(now())
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)
  @@unique([reporterId, dogId])
}
