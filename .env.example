DATABASE_URL="postgresql://petnamora:CHANGE_ME@localhost:5436/petnamora?schema=public"
JWT_SECRET="generate-a-random-secret-with-at-least-32-characters"
APP_URL="http://localhost:3003"
# Set APP_HOST=0.0.0.0 on a hosting platform; localhost is the default.
# APP_HOST="0.0.0.0"
# Development uses local storage; production defaults to Cloudflare Images.
# Set PHOTO_STORAGE=cloudflare on Railway and configure the three variables below.
# Use the Cloudflare Images account hash, not the account ID, for delivery URLs.
# The account must have a variant named public.
# PHOTO_STORAGE="cloudflare"
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_HASH=""
# Used only with PHOTO_STORAGE=local (requires a persistent volume in production).
UPLOAD_DIR="./uploads"
